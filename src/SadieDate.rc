        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "SadieDate - non-invasive date launcher"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "SadieDate"
            VALUE "OriginalFilename", "SadieDate.exe"
            VALUE "ProductName",      "SadieDate"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
